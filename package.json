{
  "name": "venice-e2ee",
  "version": "0.5.1",
  "description": "Client-side message encryption and attestation evidence for Venice AI E2EE models",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dcap": {
      "import": "./dist/dcap.js",
      "types": "./dist/dcap.d.ts"
    },
    "./nvidia": {
      "import": "./dist/nvidia.js",
      "types": "./dist/nvidia.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:browser": "esbuild src/index.ts --bundle --format=esm --outfile=dist/venice-e2ee.browser.js --target=es2022 --banner:js=\"// @ts-nocheck\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^2.1.0"
  },
  "peerDependencies": {
    "@phala/dcap-qvl": "^0.3.9 || ^0.6.1"
  },
  "peerDependenciesMeta": {
    "@phala/dcap-qvl": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elkimek/venice-e2ee.git"
  },
  "bugs": {
    "url": "https://github.com/elkimek/venice-e2ee/issues"
  },
  "homepage": "https://github.com/elkimek/venice-e2ee#readme",
  "license": "GPL-3.0-only",
  "keywords": [
    "venice",
    "e2ee",
    "encryption",
    "tee",
    "secp256k1",
    "aes-gcm"
  ]
}
